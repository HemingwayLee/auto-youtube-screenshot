FROM python:3.13-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

# ffmpeg grabs frames from the stream; yt-dlp needs a JS runtime (Deno) to solve YouTube's player challenges;
# libxcb1/libgl1/libglib2.0-0 are the shared libs opencv-python (pulled in by rapidocr) loads at import.
RUN apt-get update \
    && apt-get install -y --no-install-recommends ffmpeg libxcb1 libgl1 libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*
COPY --from=denoland/deno:bin /deno /usr/local/bin/deno

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

EXPOSE 8000
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--reload"]
